{
  "name": "@fde-gym/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"API_PORT=8787 tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "cases": "tsx server/cli.ts",
    "runner": "tsx server/runner.ts",
    "test": "tsx --test --test-concurrency=1 server/test/*.test.ts",
    "gateway": "tsx server/gateway.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/marcellus-sc": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.23.0",
    "hono": "^4.13.11",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.22",
    "undici": "^7.30.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "packageManager": "pnpm@10.2.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@codemirror/language": "6.13.1",
      "@codemirror/view": "6.43.14",
      "@codemirror/state": "6.7.6",
      "shell-quote": "^1.11.0"
    }
  }
}
