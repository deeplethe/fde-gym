# Copy to .env; docker compose reads it.

# Where your OpenRouter key is (a cheap model plays the customer's people): the folder, and the
# file's name in it. The folder is mounted read-only into the site's container.
# FDEGYM_KEY_DIR=~/.fdegym
# FDEGYM_KEY_NAME=openrouter_key

# The address people open the site at; links in password-reset mail point to it.
# FDEGYM_PUBLIC_URL=https://gym.example.com

# Accounts with these addresses are admins. Without it, the first account to sign up is.
# FDEGYM_ADMIN_EMAILS=you@example.com

# An HTTP proxy for model calls, if this machine needs one (from a container the host is host.docker.internal).
# FDEGYM_PROXY=http://host.docker.internal:7890

# Ports on this machine.
# FDEGYM_PORT=8787
# FDEGYM_PG_PORT=5432
# FDEGYM_S3_PORT=9000

# How many runs the bundled runner takes at once.
# FDEGYM_RUNNER_CAPACITY=20

# How many runs one learner may have open (not handed over) at once, and after how many days
# without being opened or used a run is ended. 0 turns either off.
# FDEGYM_MAX_OPEN_RUNS=3
# FDEGYM_RUN_IDLE_DAYS=14

# The context window, in tokens, of the model the coding agent uses. Leave unset and the site asks
# the model's provider for it (128000 where the provider does not say); set it to use another figure.
# The agent summarises its conversation as it nears this, and the workbench shows how full it is.
# FDEGYM_AGENT_CONTEXT=1000000

# How many days a run that is over keeps its files on its runner. Its result is kept for good.
# FDEGYM_KEEP_WORKSPACE_DAYS=30

# Change these before anyone else can reach the machine.
# FDEGYM_RUNNER_TOKEN=
# FDEGYM_PG_PASSWORD=
# FDEGYM_S3_ACCESS_KEY_ID=
# FDEGYM_S3_SECRET_ACCESS_KEY=
# FDEGYM_SECRET=
